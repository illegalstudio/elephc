target/
.idea/
# Python bytecode cache from repo tooling scripts (e.g. crates/elephc-image/tools/)
__pycache__/
*.pyc
# macOS Finder metadata — never track
.DS_Store
# Internal planning docs (specs/plans) — kept locally, not tracked
docs/superpowers/
# Subagent-driven-development scratch (briefs, reports, review diffs, ledger) — local only
.superpowers/
# Generated archives written to the repo root when the phar-write example
# is run from here instead of its own directory (root-anchored so the
# tracked examples/phar-reader/app.phar fixture is unaffected)
/hello.phar
/note.phar
/oop.phar
/bundle.tar
/bundle.tar.gz
/bundle.tar.bz2

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Kage's memory. `.agent_memory/packets/` is the durable, team-shared knowledge and
# IS committed; everything else under it is a regenerable local index (~175 MB —
# structural/, code_graph/, indexes/, observations/) rebuilt by `kage refresh`.
/.agent_memory/*
!/.agent_memory/packets/

# graft writes this so its gitignored cards stay greppable (ripgrep reads .ignore first).
/.ignore
