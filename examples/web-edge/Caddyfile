{
	email admin@example.com
}

example.com {
	root * /srv/app/public

	handle /static/* {
		file_server
	}

	handle {
		reverse_proxy unix//run/elephc/app.sock {
			# The origin prefers RFC 7239 Forwarded over X-Forwarded-*.
			# Caddy passes unrecognized request headers through by default,
			# so remove the client-supplied chain and replace every fact the
			# origin reads.
			header_up -Forwarded
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto {http.request.scheme}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Port {http.request.local.port}
			header_up X-Real-IP {http.request.remote.host}
			health_uri /healthz
			health_interval 10s
		}
		# Loopback TCP alternative:
		# reverse_proxy 127.0.0.1:8080
	}
}
