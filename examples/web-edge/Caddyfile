{
	email admin@example.com
}

example.com {
	root * /srv/app/public

	handle /static/* {
		file_server
	}

	handle {
		reverse_proxy unix//run/elephc/app.sock {
			# Caddy sets X-Forwarded-For/Proto/Host but not Port; set it so a
			# client-supplied X-Forwarded-Port cannot survive.
			header_up X-Forwarded-Port {http.request.port}
			health_uri /healthz
			health_interval 10s
		}
		# Loopback TCP alternative:
		# reverse_proxy 127.0.0.1:8080
	}
}
